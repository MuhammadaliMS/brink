<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Not sandboxed: event taps and MultitouchSupport are unavailable in the sandbox.
       Private frameworks are dlopen'd from the system, which hardened runtime allows. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
